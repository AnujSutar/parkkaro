# Copy this file to ".env" (same folder as index.php) and fill in your own values.
# ".env" is ignored by Git. The defaults below are the XAMPP defaults.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=parkaro

# Secret used to sign ticket links. Leave empty and the app creates one in
# storage/app.key on first use. To set your own:  php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Timezone used for reservation times (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Online payments (Razorpay). Leave empty to disable online payment; admin-recorded
# cash still works. Use TEST keys first (rzp_test_...). NEVER commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret in Razorpay Dashboard > Webhooks (URL: https://YOUR-DOMAIN/payment_webhook.php, event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Admin (parking owner) registration on register.php?type=admin
#   ADMIN_REGISTRATION=off    -> switch public admin sign-up off (admins then only via tools/create_admin.php or admin_create.php)
#   ADMIN_SIGNUP_CODE=...     -> visitors must also enter this code (recommended on a public server)
ADMIN_REGISTRATION=on
ADMIN_SIGNUP_CODE=

# ---------------------------------------------------------------------------
# Ticket confirmations (needs database migration 002). Every part is OPTIONAL:
# a channel with missing settings is simply skipped; payments and bookings still work.
# Full guide: docs/NOTIFICATIONS_SETUP.md.   NEVER commit real values.
# ---------------------------------------------------------------------------
# Public address of the site, used for the ticket link inside messages (no trailing slash)
APP_BASE_URL=http://localhost/parkkaro_upgraded/project

# E-mail (SMTP). Gmail example: smtp.gmail.com, port 587, MAIL_SECURE=tls, an "App password" (needs 2-step verification)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Parkaro

# SMS and WhatsApp through Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: a Twilio phone number like +1555..., or a Messaging Service SID (MG...)
TWILIO_SMS_FROM=
# WhatsApp sender: the sandbox number (whatsapp:+14155238886) or your approved WhatsApp Business sender
TWILIO_WHATSAPP_FROM=
# Optional but REQUIRED for real customers outside the 24-hour window: the approved template (Content SID, HX...)
TWILIO_WHATSAPP_CONTENT_SID=
