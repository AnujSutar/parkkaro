<?php
session_start();  // Start the session

// Assuming the admin's zone is stored in the session after login
if (!isset($_SESSION['admin_zone'])) {
    // Redirect to login page if the admin is not logged in
    header("Location: login.php");
    exit();
}

$admin_zone = $_SESSION['admin_zone']; // Get the logged-in admin's zone

// Connect to the database
$servername = "localhost";
$username = "root";
$password = "";
$dbname = "parkaro";  // Replace with your actual database name

$conn = new mysqli($servername, $username, $password, $dbname);

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// Query to get the total number of bookings for the admin's zone
$sql_total = "SELECT COUNT(*) AS total FROM bookings WHERE admin_zone = '$admin_zone'";
$result_total = $conn->query($sql_total);
$total_bookings = $result_total->fetch_assoc()['total'];

// Query to get the count of bookings by the admin's zone (excluding status)
$sql_pending = "SELECT COUNT(*) AS pending FROM bookings WHERE admin_zone = '$admin_zone' AND status = 'Pending'";
$result_pending = $conn->query($sql_pending);
$pending_bookings = $result_pending->fetch_assoc()['pending'];

$sql_confirmed = "SELECT COUNT(*) AS confirmed FROM bookings WHERE admin_zone = '$admin_zone' AND status = 'Confirmed'";
$result_confirmed = $conn->query($sql_confirmed);
$confirmed_bookings = $result_confirmed->fetch_assoc()['confirmed'];

$sql_canceled = "SELECT COUNT(*) AS canceled FROM bookings WHERE admin_zone = '$admin_zone' AND status = 'Canceled'";
$result_canceled = $conn->query($sql_canceled);
$canceled_bookings = $result_canceled->fetch_assoc()['canceled'];

// Get all bookings for the admin's zone
$sql_bookings = "SELECT * FROM bookings WHERE admin_zone = '$admin_zone' ORDER BY booking_time DESC";
$result_bookings = $conn->query($sql_bookings);

// Close the connection
$conn->close();
?>

